# Postgres Connection
DATABASE_URL=postgresql://admin:password@localhost:5432/freshers_db

# GitHub PAT for Gist creation (generate_gist.py)
# Scope needed: "gist"
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Wayback Machine S3 API Keys (optional for archive_and_deactivate.py)
# Free from: https://archive.org/account/s3.php
# If omitted, archive_and_deactivate.py falls back to anonymous mode.
WAYBACK_ACCESS_KEY=your_archive_org_access_key
WAYBACK_SECRET_KEY=your_archive_org_secret_key
JWT_SECRET = "random"  